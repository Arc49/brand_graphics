{
  "_doc": "Each render: template id, optional name (output folder), theme (dark|light, default from brand.json), props (override template defaults), formats.",
  "renders": [
    { "template": "logo_sting" },
    { "template": "lower_third", "props": { "name": "Alex Rivera", "title": "Founder · Visual Cranio" } },
    { "template": "lower_third", "theme": "light", "props": { "name": "Alex Rivera", "title": "Founder · Visual Cranio" } },
    { "template": "title_card", "props": { "label": "Myth 01", "title": "Your jawline is fixed at 18" } },
    { "template": "title_card", "theme": "light", "props": { "label": "Myth 02", "title": "Mewing changes your skull overnight" } },
    { "template": "callout", "props": { "text": "Bone vs. soft tissue", "icon": "⬡" } },
    { "template": "callout", "theme": "light", "props": { "text": "Myth", "icon": "✕" } },
    { "template": "punch_text" },
    { "name": "punch_text_story", "template": "punch_text", "theme": "light", "props": { "background": true }, "formats": ["vertical"] },
    { "template": "stat_counter", "props": { "value": 22, "suffix": "", "label": "bones in the human skull", "compact": false, "countDur": 1.2 } },
    { "template": "list_reveal", "props": { "heading": "Fix these first", "items": ["Posture", "Sleep", "Body fat %"] } },
    { "template": "list_reveal", "theme": "light", "props": { "heading": "Fix these first", "items": ["Posture", "Sleep", "Body fat %"] } },
    { "name": "transition_bands", "template": "transition", "props": { "style": "bands" } },
    { "name": "transition_iris", "template": "transition", "props": { "style": "iris" } },
    { "name": "transition_slide", "template": "transition", "props": { "style": "slide", "dur": 0.8 } },
    { "template": "cta_subscribe" },
    { "name": "cta_follow", "template": "cta_subscribe", "theme": "light", "props": { "label": "Follow", "doneLabel": "Following" }, "formats": ["vertical"] },
    { "template": "end_card", "props": { "hold": 10 } }
  ]
}
